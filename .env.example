# Contoh env untuk development lokal.
# Copy jadi .env.local dan isi nilainya. JANGAN commit .env.local.

# --- Supabase (wajib untuk mode CMS/database) ---
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- Admin CMS (wajib untuk /login + /admin) ---
# Username + password akun admin tunggal.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Secret penandatangan session (string acak, minimal 32 karakter).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
